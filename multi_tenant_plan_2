### Middleware — `TenantResolverMiddleware`

#### [NEW] `SCMS.Shared/Middlewares/TenantResolverMiddleware.cs`

```csharp
public class TenantResolverMiddleware
{
    private readonly RequestDelegate _next;

    public async Task InvokeAsync(HttpContext context, ITenantContext tenantContext)
    {
        var path = context.Request.Path.Value?.ToLowerInvariant() ?? "";

        // ── Skip rules ──
        // 1. Owner routes: starts with "/api/owner/"
        // 2. Tenant resolve: starts with "/api/tenant/v1/resolve" (or exact match)
        // 3. Swagger/Scalar/OpenAPI paths
        if (ShouldSkip(path))
        {
            await _next(context);
            return;
        }

        // ── Extract tenant code ──
        var tenantCode = context.Request.Headers["x-tenant-code"].FirstOrDefault();
        if (string.IsNullOrWhiteSpace(tenantCode))
        {
            context.Response.StatusCode = 400;
            // write ErrorResponse JSON
            return;
        }

        await tenantContext.ResolveAsync(tenantCode, context.RequestAborted);
        await _next(context);
    }

    private static bool ShouldSkip(string path) =>
        path.StartsWith("/api/owner/") ||
        path.StartsWith("/api/tenant/v1/resolve") ||
        path.StartsWith("/openapi") ||
        path.StartsWith("/scalar");
}
```

> [!NOTE]
> **Route prefix**: Owner controllers use `api/owner/v1/...`, so skipping anything starting with `/api/owner/` covers all current and future owner routes. The `/resolve` endpoint also skips because it's the one that _provides_ the tenant code.

